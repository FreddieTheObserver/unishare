# prod: https://your-api-domain.com
API_URL=http://localhost:3001
# prod: https://your-app-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Identity provider (mirrors the API's AUTH_MODE; baked in at build time).
NEXT_PUBLIC_AUTH_MODE=legacy                       # uniauth = sign in on uniauth (OIDC)
NEXT_PUBLIC_UNIAUTH_URL=http://localhost:3002      # uniauth origin, for account-page links
